# Dependências
node_modules/

# Build e cache
dist/
# O build de arquivo único da feira (P8-05), gerado por `npm run build:feira`.
dist-feira/
dist-ssr/
.vite/
*.tsbuildinfo

# Cobertura de testes (Vitest)
coverage/

# Variáveis de ambiente
# O jogo é 100% client-side (FORMA-DE-TRABALHO.md §2) — se um .env aparecer, desconfie.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Configuração local da ferramenta de agente
# ATENÇÃO: .claude/settings.json É versionado de propósito (FORMA-DE-TRABALHO.md §4.1) —
# ele carrega os guardrails de git para todo mundo que entrar no projeto.
# Só o settings.local.json, que é por máquina, fica de fora.
.claude/settings.local.json

# Editores
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Sistema operacional
Thumbs.db
desktop.ini
.DS_Store

# Arquivos locais soltos
*.local
